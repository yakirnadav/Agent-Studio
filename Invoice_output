## 10. Orchestrator Control-Loop Pseudocode

```python
def run(job):
    ctx = init_job(job)                      # H1: audit_id, validate intake
    audit(ctx, "received")

    # ---- Stage A: extraction gate ----
    inv = call(A1, ctx)                       # H2 (+H3 FX inside)
    ctx.canonical_invoice, ctx.field_confidences = inv.invoice, inv.confidences
    if not minimal_fields_present(inv):
        return finalize(ctx, status="failed", route="human_triage")  # never "reject"

    # ---- Stage B: parallel verification fan-out ----
    branches = parallel([
        deadline(call, A2, ctx, budget=6s),   # H4
        deadline(call, A3, ctx, budget=6s),   # H5  (no cache)
        deadline(call, A4, ctx, budget=6s),   # H6
        deadline(call, A5, ctx, budget=6s),   # H7
    ], stage_deadline=10s)
    for b in branches:
        ctx.evidence[b.dim] = b.result_or_unverified()
        ctx.coverage_map[b.dim] = b.coverage   # full|partial|none

    # ---- Stage C: deterministic scoring (single authority) ----
    ctx.score = call(T1, ctx.evidence, ctx.coverage_map, weights_version)  # H8
    apply_hard_caps(ctx.score, ctx.evidence)   # duplicate/high-anomaly → band ceiling

    # ---- Stage D: grounded narrative ----
    expl = call(A6, ctx.score, ctx.evidence)   # H9
    if not grounded(expl, ctx.evidence):
        expl = call(A6, ..., strict=True) or fallback_template(ctx)

    # ---- Stage E: advisory handoff (no approval field) ----
    payload = assemble_assessment(ctx, expl)   # human_decision_required = TRUE (fixed)
    assert "approved" not in payload and "rejected" not in payload  # invariant guard
    deliver(payload)                           # H10

    status = "completed_with_degradation" if any_unverified(ctx) else "completed"
    return finalize(ctx, status)
```

